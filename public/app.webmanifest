{
    "id": "/",
    "name": "Webremote for Songbeamer",
    "short_name": "SB Remote",
    "description": "Web application for controlling songbeamer over the network",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone"],
    "background_color": "#000000",
    "theme_color": "#BB7EFF",
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
        {
            "src": "/img/screenshots/desktop-1280x720.webp",
            "sizes": "1280x720",
            "type": "image/webp",
            "form_factor": "wide",
            "label": "Desktop main view"
        },
        {
            "src": "/img/screenshots/pixel10-571x1280.webp",
            "sizes": "571x1280",
            "type": "image/webp",
            "label": "Mobile main view"
        }
    ]
}
